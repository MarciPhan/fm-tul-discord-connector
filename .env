# ==============================================================================
# FM TUL ↔ DISCORD CONNECTOR (Inspirováno discord-pslib-connector)
# ==============================================================================

# --- MICROSOFT ENTRA ID (TUL) OAUTH2 ---
# Údaje získané po registraci aplikace v TUL tenantu (LIANE)
MSAL_CLIENT_ID="SEM_VLOZTE_MSAL_CLIENT_ID"
MSAL_CLIENT_SECRET="SEM_VLOZTE_MSAL_CLIENT_SECRET"
MSAL_TENANT_ID="SEM_VLOZTE_MSAL_TENANT_ID"

# --- DISCORD OAUTH2 & BOT ---
# Údaje z Discord Developer Portalu (https://discord.com/developers/applications)
# V záložce "OAuth2": Client ID a Client Secret
DISCORD_CLIENT_ID="SEM_VLOZTE_DISCORD_CLIENT_ID"
DISCORD_CLIENT_SECRET="SEM_VLOZTE_DISCORD_CLIENT_SECRET"

# V záložce "Bot": Bot Token
DISCORD_TOKEN="SEM_VLOZTE_DISCORD_BOT_TOKEN"

# ID vašeho Discord serveru (Guild ID)
DISCORD_GUILD_ID="123456789012345678"

# Role na Discord serveru
# Role pro ověřené uživatele (např. "Ověřený" / "Student FM")
DISCORD_VERIFIED_ID="123456789012345678"
# Specifická role pro studenty FM (pokud chcete odděleně od základního ověření)
DISCORD_FM_STUDENT_ID="123456789012345678"
# Specifická role pro zaměstnance / vyučující FM (volitelně)
DISCORD_FM_STAFF_ID="123456789012345678"

# Ověření přes reakci na zprávu
# Emoji, na které má bot reagovat (výchozí: 🎓)
DISCORD_VERIFY_EMOJI="🎓"
# (Volitelné) ID konkrétní zprávy, na kterou se má reagovat. Pokud necháte prázdné, reaguje na zvolené emoji kdekoli na serveru.
DISCORD_VERIFY_MESSAGE_ID=""

# Odkaz na pozvánku na váš Discord server (uživatel je tam po ověření přesměrován)
DISCORD_INVITE_URL="https://discord.gg/vase-pozvanka"

# --- SERVER KONFIGURACE ---
HOST="0.0.0.0"
PORT="8000"
# Veřejná URL vašeho serveru (např. https://discord.fm.tul.cz nebo http://localhost:8000)
BASE_URL="http://localhost:8000"

# --- BEZPEČNOSTNÍ NASTAVENÍ (HARDENING) ---
# Povolení vývojářských simulací (Mock MS & Discord). V PRODUKCI VŽDY FALSE!
ENABLE_DEV_MOCK="true"

# Vynucení Secure flagu u cookies (nastavte "true", pokud běžíte na HTTPS)
SECURE_COOKIES="false"

# Povolení vestavěného Rate Limiteru (ochrana proti DoS a brute-force)
RATE_LIMIT_ENABLED="true"
