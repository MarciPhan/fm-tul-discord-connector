# --- MICROSOFT ENTRA ID (OAUTH2) KONFIGURACE ---
# Tyto udaje obdrzite od spravy site LIANE po registraci aplikace v TUL tenantu
MICROSOFT_CLIENT_ID="SEM_VLOZTE_CLIENT_ID"
MICROSOFT_CLIENT_SECRET="SEM_VLOZTE_CLIENT_SECRET"
MICROSOFT_TENANT_ID="SEM_VLOZTE_TENANT_ID_TUL"

# Redirect URI registrovana v Azure / Entra ID
# Pro vyvoj: http://localhost:8000/callback
# Pro produkci: https://vase-domena.tul.cz/callback
REDIRECT_URI="http://localhost:8000/callback"

# --- DISCORD BOT KONFIGURACE ---
# Token bota z Discord Developer Portal (https://discord.com/developers/applications)
DISCORD_TOKEN="SEM_VLOZTE_DISCORD_BOT_TOKEN"

# ID vaseho Discord serveru (Guild ID)
GUILD_ID="123456789012345678"

# Role, ktere ma bot pridelovat
# ID role pro overene studenty Fakulty mechatroniky
FM_STUDENT_ROLE_ID="123456789012345678"
# ID role pro zamestnance / vyucujici FM (volitelne)
FM_STAFF_ROLE_ID="123456789012345678"

# --- NASTAVENI SERVERU ---
PORT="8000"
HOST="0.0.0.0"
